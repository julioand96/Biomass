      "source": [
        "from skorch import NeuralNetRegressor\n",
        "from sklearn.model_selection import GroupKFold\n",
        "\n",
        "net = NeuralNetRegressor(\n",
        "    BiomassModel,\n",
        "    module__model_name=CFG.model_name,\n",
        "    module__metadata_dim=metadata_dim,\n",
        "    module__n_targets=len(target_cols),\n",
        "    criterion=nn.MSELoss,\n",
        "    optimizer=torch.optim.Adam,\n",
        "    lr=CFG.lr,\n",
        "    max_epochs=CFG.n_epochs,\n",
        "    batch_size=CFG.batch_size,\n",
        "    device=CFG.device,\n",
        "    # Shuffle training data on each epoch\n",
        "    iterator_train__shuffle=True,\n",
        ")\n",
        "\n",
        "# Skorch handles the training loop, so we just need to call fit.\n",
        "# For demonstration, we'll use a single fold as before.\n",
        "gkf = GroupKFold(n_splits=CFG.n_folds)\n",
        "groups = train_df['Sampling_Date']\n",
        "train_idx, val_idx = next(gkf.split(train_df, groups=groups))\n",
        "\n",
        "train_fold_df = train_df.iloc[train_idx]\n",
        "val_fold_df = train_df.iloc[val_idx]\n",
        "\n",
        "train_dataset = BiomassDataset(train_fold_df, preprocessor, transforms)\n",
        "val_dataset = BiomassDataset(val_fold_df, preprocessor, transforms)\n",
        "\n",
        "# The validation data is passed to the fit method to be used for scoring.\n",
        "net.fit(train_dataset, y=None) # y is not needed here as it is in the dataset\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Hyperparameter Search with GridSearchCV\n",
        "\n",
        "Now that we have a `skorch` wrapper for our PyTorch model, we can use scikit-learn's `GridSearchCV` to find the best hyperparameters for our model. We will search for the best learning rate and optimizer."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from sklearn.model_selection import GridSearchCV\n",
        "\n",
        "# We will use a smaller subset of the data for the grid search for speed.\n",
        "train_subset_df = train_fold_df.sample(frac=0.5, random_state=CFG.seed)\n",
        "train_subset_dataset = BiomassDataset(train_subset_df, preprocessor, transforms)\n",
        "\n",
        "params = {\n",
        "    'lr': [1e-4, 1e-3, 1e-2],\n",
        "    'optimizer': [torch.optim.Adam, torch.optim.SGD],\n",
        "}\n",
        "\n",
        "# We need to pass the validation data to the fit method for grid search to work.\n",
        "# However, GridSearchCV does not support this directly. \n",
        "# A workaround is to use a predefined split for the cross-validation.\n",
        "# For simplicity, we will not use a separate validation set for grid search here.\n",
        "# Instead, we rely on the cross-validation of GridSearchCV.\n",
        "\n",
        "gs = GridSearchCV(net, params, refit=True, cv=2, scoring='neg_mean_squared_error', verbose=2)\n",
        "\n",
        "gs.fit(train_subset_dataset, y=None)\n",
        "\n",
        "print(f\"Best score: {gs.best_score_}\")\n",
        "print(f\"Best params: {gs.best_params_}\")\n",
        "\n",
        "# The best estimator is already fitted on the whole data, so we can use it for inference.\n",
        "net = gs.best_estimator_"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. Evaluate and Report Results\n",
        "\n",
        "After finding the best hyperparameters, we evaluate the model using cross-validation on the full training set."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "scores = cross_val_score(net, train_dataset, y=None, cv=gkf.split(train_df, groups=groups), scoring='r2')\n",
        "print(f\"R² scores for each fold: {scores}\")\n",
        "print(f\"Average R² score: {scores.mean():.4f} ± {scores.std():.4f}\")"
      ]
